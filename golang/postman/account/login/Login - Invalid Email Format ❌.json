{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Login - Invalid Email Format ❌",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "37760297",
    "description": "Test case for login with invalid email format"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login - Invalid Email Format ❌",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 (Bad Request)\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Response contains error message about invalid email format\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "    pm.expect(responseJson.error.toLowerCase()).to.satisfy(function(msg) {",
              "        return msg.includes('email') && (msg.includes('invalid') || msg.includes('format') || msg.includes('malformed'));",
              "    });",
              "});",
              "",
              "pm.test(\"No token is returned\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.not.have.property('token');",
              "    pm.expect(responseJson).to.not.have.property('jwt_token');",
              "    pm.expect(responseJson).to.not.have.property('access_token');",
              "});",
              "",
              "pm.test(\"No user data is returned\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.not.have.property('id');",
              "    pm.expect(responseJson).to.not.have.property('name');",
              "    pm.expect(responseJson).to.not.have.property('user');",
              "});",
              "",
              "pm.test(\"Response time is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Testing various invalid email formats",
              "// This specific test uses email without @ symbol"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"invalid-email-format\",\n    \"password\": \"validPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/accounts/auth/login",
          "host": ["{{base_url}}"],
          "path": ["accounts", "auth", "login"]
        }
      }
    }
  ]
}