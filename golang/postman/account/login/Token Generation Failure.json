{
  "info": {
    "_postman_id": "h8i9j0k1-l2m3-4567-hijk-lm8901234567",
    "name": "Login - Token Generation Failure ❌",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "37760297",
    "description": "Test case for login when JWT token generation fails"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login - Token Generation Failure ❌",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 500 (Internal Server Error)\", function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "",
              "pm.test(\"Response contains error message about token generation\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "    pm.expect(responseJson.error.toLowerCase()).to.satisfy(function(msg) {",
              "        return msg.includes('token') || msg.includes('authentication failed') || msg.includes('internal error') || msg.includes('jwt');",
              "    });",
              "});",
              "",
              "pm.test(\"No token is returned\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.not.have.property('token');",
              "    pm.expect(responseJson).to.not.have.property('jwt_token');",
              "    pm.expect(responseJson).to.not.have.property('access_token');",
              "});",
              "",
              "pm.test(\"User credentials were valid but token failed\", function () {",
              "    const responseJson = pm.response.json();",
              "    // Should not return user data if token generation fails",
              "    pm.expect(responseJson).to.not.have.property('id');",
              "    pm.expect(responseJson).to.not.have.property('name');",
              "    pm.expect(responseJson).to.not.have.property('user');",
              "});",
              "",
              "pm.test(\"Response time is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Testing JWT token generation failure",
              "// This could happen if JWT secret is missing or corrupted",
              "// Or if there's an issue with the token generation library",
              "// This is difficult to simulate without modifying server configuration"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"john.doe@example.com\",\n    \"password\": \"SecurePassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/accounts/auth/login",
          "host": ["{{base_url}}"],
          "path": ["accounts", "auth", "login"]
        }
      }
    }
  ]
}