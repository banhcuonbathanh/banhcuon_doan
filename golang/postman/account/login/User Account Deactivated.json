{
  "info": {
    "_postman_id": "f6g7h8i9-j0k1-2345-fghi-jk6789012345",
    "name": "Login - User Account Deactivated/Disabled ❌",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "37760297",
    "description": "Test case for login with deactivated or disabled user account"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login - User Account Deactivated/Disabled ❌",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 (Forbidden) or 401 (Unauthorized)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});",
              "",
              "pm.test(\"Response contains error message about deactivated account\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "    pm.expect(responseJson.error.toLowerCase()).to.satisfy(function(msg) {",
              "        return msg.includes('deactivated') || msg.includes('disabled') || msg.includes('suspended') || msg.includes('inactive');",
              "    });",
              "});",
              "",
              "pm.test(\"No token is returned\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.not.have.property('token');",
              "    pm.expect(responseJson).to.not.have.property('jwt_token');",
              "    pm.expect(responseJson).to.not.have.property('access_token');",
              "});",
              "",
              "pm.test(\"No user data is returned\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.not.have.property('id');",
              "    pm.expect(responseJson).to.not.have.property('name');",
              "    pm.expect(responseJson).to.not.have.property('user');",
              "});",
              "",
              "pm.test(\"Response time is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Testing with deactivated user account",
              "// This assumes there's a user account that has been deactivated",
              "// You may need to create a deactivated user first or use a test account"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"deactivated.user@example.com\",\n    \"password\": \"CorrectPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/accounts/auth/login",
          "host": ["{{base_url}}"],
          "path": ["accounts", "auth", "login"]
        }
      }
    }
  ]
}