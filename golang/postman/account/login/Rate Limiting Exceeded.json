{
  "info": {
    "_postman_id": "l2m3n4o5-p6q7-8901-lmno-pq2345678901",
    "name": "Login - Rate Limiting Exceeded ❌",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "37760297",
    "description": "Test case for login when rate limiting threshold is exceeded"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login - Rate Limiting Exceeded ❌",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 429 (Too Many Requests)\", function () {",
              "    pm.response.to.have.status(429);",
              "});",
              "",
              "pm.test(\"Response contains error message about rate limiting\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "    pm.expect(responseJson.error.toLowerCase()).to.satisfy(function(msg) {",
              "        return msg.includes('rate limit') || msg.includes('too many') || msg.includes('requests') || msg.includes('retry');",
              "    });",
              "});",
              "",
              "pm.test(\"Rate limit headers are present\", function () {",
              "    // Check for common rate limiting headers",
              "    const hasRateLimitHeaders = pm.response.headers.has('X-RateLimit-Limit') ||",
              "                                pm.response.headers.has('X-Rate-Limit-Limit') ||",
              "                                pm.response.headers.has('Retry-After') ||",
              "                                pm.response.headers.has('X-RateLimit-Remaining');",
              "    pm.expect(hasRateLimitHeaders).to.be.true;",
              "});",
              "",
              "pm.test(\"No token is returned\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.not.have.property('token');",
              "    pm.expect(responseJson).to.not.have.property('jwt_token');",
              "    pm.expect(responseJson).to.not.have.property('access_token');",
              "});",
              "",
              "pm.test(\"No user data is returned\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.not.have.property('id');",
              "    pm.expect(responseJson).to.not.have.property('name');",
              "    pm.expect(responseJson).to.not.have.property('user');",
              "});",
              "",
              "pm.test(\"Response time is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Testing rate limiting",
              "// This test assumes rate limiting is configured",
              "// You may need to make multiple rapid requests to trigger this",
              "// or configure a low rate limit threshold for testing"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"john.doe@example.com\",\n    \"password\": \"SecurePassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/accounts/auth/login",
          "host": ["{{base_url}}"],
          "path": ["accounts", "auth", "login"]
        }
      }
    }
  ]
}