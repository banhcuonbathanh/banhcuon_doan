        {
          "name": "Cleanup - Success with Expired Tokens ✅",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 (OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success status\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('success', true);",
                  "});",
                  "",
                  "pm.test(\"Response contains cleanup message\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('message');",
                  "    pm.expect(responseJson.message).to.be.a('string');",
                  "    pm.expect(responseJson.message).to.include('completed successfully');",
                  "});",
                  "",
                  "pm.test(\"Response contains job identifier\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('job', 'token_cleanup');",
                  "});",
                  "",
                  "pm.test(\"Response contains duration metrics\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('duration_ms');",
                  "    pm.expect(responseJson.duration_ms).to.be.a('number');",
                  "    pm.expect(responseJson.duration_ms).to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test(\"Response time is within acceptable range\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
