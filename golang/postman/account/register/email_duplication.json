{
  "info": {
    "_postman_id": "14612249-7a96-4888-be2f-51c3b2f42d32",
    "name": "Account API - Enhanced Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "37760297",
    "description": "Enhanced collection with comprehensive account management test cases based on Go Chi router structure"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Register User - Email Duplication ❌",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 409 (Conflict)\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test(\"Response contains error message about duplicate email\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.have.property('error');",
              "    pm.expect(responseJson.error.toLowerCase()).to.include('email');",
              "    pm.expect(responseJson.error.toLowerCase()).to.satisfy(function(msg) {",
              "        return msg.includes('already') || msg.includes('exists') || msg.includes('taken') || msg.includes('duplicate');",
              "    });",
              "});",
              "",
              "pm.test(\"No user data is returned\", function () {",
              "    const responseJson = pm.response.json();",
              "    pm.expect(responseJson).to.not.have.property('id');",
              "    pm.expect(responseJson).to.not.have.property('name');",
              "});",
              "",
              "pm.test(\"Response time is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// This test assumes the email john.doe@example.com already exists",
              "// If running this collection in sequence, the previous successful registration",
              "// should have created this email address"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Jane Smith\",\n    \"email\": \"john.doe@example.com\",\n    \"password\": \"AnotherPassword456!\",\n    \"confirm_password\": \"AnotherPassword456!\",\n    \"role\": \"\",\n    \"avatar\": \"https://example.com/jane.jpg\",\n    \"title\": \"Product Manager\",\n    \"branch_id\": 1,\n    \"owner_id\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/accounts/auth/register",
          "host": ["{{base_url}}"],
          "path": ["accounts", "auth", "register"]
        }
      }
    }
  ]
}
